# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SQLITE_DB_PATH=db.sqlite3
HOST=127.0.0.1
PORT=8000
RELOAD=false
# Creates missing tables only. It does not migrate an existing database.
INIT_DB=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:3000"]
# Set false ONLY for local development over HTTP; use true with HTTPS.
COOKIE_SECURE=true
BASE_URL=http://localhost:8000
BASE_URL_NEXT=http://localhost:3000
# Optional Google OAuth; all three values are required to enable it.
OAUTH_CLIENT_ID=
OAUTH_SECRET=
OAUTH_REDIRECT_URI=
